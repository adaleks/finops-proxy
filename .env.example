# FinOps Proxy — Docker Compose environment
#
# Copy this file to `.env` to customize the `docker compose up` quickstart:
#   cp .env.example .env
#
# Every value below mirrors a ${VAR:-default} interpolation in docker-compose.yml.
# The proxy binary itself reads CLI flags (not env vars); docker compose turns
# these values into flags for you.

# Listen address for the proxy container.
FINOPS_ADDR=:8080

# Upstream LLM API base URL. Defaults to the bundled mock server (dev-only).
# Point at a real endpoint to go to prod:
#   FINOPS_UPSTREAM=http://localhost:11434/v1   # local Ollama
#   FINOPS_UPSTREAM=https://api.openai.com/v1   # OpenAI
FINOPS_UPSTREAM=http://mockserver:8081

# Loop-detection fingerprint TTL window.
FINOPS_TTL=5m

# Repeat threshold before blocking (1 = block on first repeat).
FINOPS_LIMIT=2

# Enable all dynamic loop detectors (structural + tool-cycle + velocity).
FINOPS_DYNAMIC=true

# Static price-table path inside the container (required at startup).
FINOPS_PRICING_PATH=/app/config/pricing.json

# Remote price-catalog endpoint. Empty = static-only pricing (no network fetch).
FINOPS_PRICING_URL=

# SQLite path inside the container. Empty = in-memory store.
# For persistence, set to /data/finops.db and uncomment the `finops-data` volume
# in docker-compose.yml.
FINOPS_DB_PATH=

# Keys file inside the container (per-key budgets + auth), mounted from
# keys.example.json. Set to "" to disable auth (fail-open).
FINOPS_KEYS_PATH=/app/config/keys.json

# Global daily budget in µUSD (0 = disabled; raises budget_level alerts).
FINOPS_DAILY_BUDGET_MICRO=0

# Daily budget alert thresholds (comma-separated percentages).
FINOPS_BUDGET_THRESHOLDS=50,80,100
